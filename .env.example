# ==================================================================
# dematgames.com — variables d'environnement
#
# Copiez ce fichier en `.env.local` et renseignez vos valeurs.
# `.env.local` est ignoré par Git (voir .gitignore) : aucune clé ne
# doit JAMAIS être commitée.
# ==================================================================

# URL publique du site — métadonnées, sitemap, URLs canoniques.
# En local, laisser vide : http://localhost:3000 est utilisé par défaut.
NEXT_PUBLIC_SITE_URL=https://dematgames.com


# ------------------------------------------------------------------
# Firebase — authentification Google + Firestore
#
# Ces valeurs NEXT_PUBLIC_* sont publiques par conception : elles
# identifient le projet, elles ne l'autorisent pas. La sécurité repose
# sur les règles Firestore et sur la liste des domaines autorisés dans
# la console Firebase — pas sur le secret de ces clés.
#
# Où les trouver : console Firebase → Paramètres du projet →
# « Vos applications » → application Web → Configuration du SDK.
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ------------------------------------------------------------------
# Cloudinary — images (jaquettes, blog, uploads développeurs)
#
# ⚠️ CLOUDINARY_API_SECRET est un secret serveur. Il ne porte PAS le
# préfixe NEXT_PUBLIC_ et ne doit jamais être importé dans un composant
# client : il signe les uploads et donne un accès en écriture complet.
#
# Seul le cloud name est public (il apparaît dans les URLs d'images).
# ------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ------------------------------------------------------------------
# À brancher plus tard — aucune n'est nécessaire pour faire tourner
# le site aujourd'hui.
# ------------------------------------------------------------------

# Notification email des candidatures (Resend)
# RESEND_API_KEY=

# Paiements (Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
